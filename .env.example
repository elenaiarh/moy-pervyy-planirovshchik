NODE_ENV=production
ASSIYA_HOST=127.0.0.1
ASSIYA_PORT=3020
ASSIYA_DB_PATH=/var/lib/assiya/assiya.sqlite
ASSIYA_UPLOADS_DIR=/var/lib/assiya/uploads
ASSIYA_BACKUP_DIR=/var/backups/assiya
ASSIYA_BACKUP_KEEP=30
ASSIYA_COOKIE_SECURE=true
ASSIYA_SESSION_DAYS=180
ASSIYA_LOGIN_WINDOW_MINUTES=15
ASSIYA_LOGIN_MAX_FAILURES=5
ASSIYA_VAPID_PUBLIC_KEY=
ASSIYA_VAPID_PRIVATE_KEY=
ASSIYA_VAPID_SUBJECT=mailto:admin@myplaning.platunova-fin.ru
ASSIYA_NOTIFICATION_TIMEZONE=Europe/Kirov
ASSIYA_PUSH_INTERVAL_MS=60000
