[Unit]
Description=ASSIYA private planner
After=network.target

[Service]
Type=simple
User=assiya
Group=assiya
WorkingDirectory=/var/www/myplaning.platunova-fin.ru
EnvironmentFile=/var/www/myplaning.platunova-fin.ru/.env
ExecStart=/usr/bin/npm run server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/assiya /var/backups/assiya /var/www/myplaning.platunova-fin.ru

[Install]
WantedBy=multi-user.target
